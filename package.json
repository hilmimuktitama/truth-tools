{
  "name": "truth-tools",
  "version": "0.3.0",
  "description": "Deterministic evidence gate for project status reports.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "truth-tools": "bin/truth-tools.js",
    "truth-tools-mcp": "src/mcp-server.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check bin/truth-tools.js && node --check src/cli.js && node --check src/mcp-server.js && node --check src/mcp-tools.js && node --check src/report.js && node --check src/review.js",
    "pack:dry-run": "npm pack --dry-run",
    "example": "node bin/truth-tools.js review --input examples/product-launch.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "evidence",
    "project-status",
    "program-management",
    "tpm",
    "audit"
  ],
  "author": "Hilmi Muktitama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilmimuktitama/truth-tools.git"
  },
  "bugs": {
    "url": "https://github.com/hilmimuktitama/truth-tools/issues"
  },
  "homepage": "https://github.com/hilmimuktitama/truth-tools#readme"
}
