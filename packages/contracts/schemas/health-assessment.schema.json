{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-tools.dev/schemas/health-assessment.schema.json",
  "title": "HealthAssessment",
  "description": "An explicit, accountable statement of reported program health. Truth Tools checks its structural support and consistency with active health claims; it does not independently determine real-world health.",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "owner", "rationale", "source_refs"],
  "properties": {
    "state": { "type": "string", "enum": ["on_track", "at_risk", "blocked", "unknown"] },
    "owner": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "https://truth-tools.dev/schemas/source-ref.schema.json" }
    }
  }
}
