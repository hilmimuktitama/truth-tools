{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-tools.dev/schemas/truth-review.schema.json",
  "title": "TruthReview",
  "description": "TruthReview v2.0.0 reports independent evidence quality and explicit health dimensions. Algorithm: consider only active claims (superseded and historical claims do not affect health). claim_health_floor is blocked when any active blocker exists, at_risk when there is no active blocker and any active risk or unknown exists, and none otherwise. program_health resolves to blocked when the floor is blocked, otherwise to at_risk when the floor is at_risk, otherwise to the reported health when it is blocked, otherwise to on_track only when at least one active fact exists and the reported health is on_track; in all other cases it is unknown. reported_program_health is the supplied HealthAssessment state, and health_consistency records missing, consistent, understated, unsupported, or conflicting relationships. artifact_quality is fail for any contradiction or blocking finding, including health_assessment_conflicts_with_blocker; needs_review is for non-blocking findings; pass has neither.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "initiative",
    "as_of",
    "policy",
    "artifact_quality",
    "reported_program_health",
    "claim_health_floor",
    "program_health",
    "health_consistency",
    "summary",
    "sources",
    "claims",
    "findings",
    "recommended_actions"
  ],
  "properties": {
    "kind": {
      "const": "truth_review"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 }
      }
    },
    "as_of": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_observation_age_days", "max_source_content_age_days"],
      "properties": {
        "max_observation_age_days": { "type": "integer", "minimum": 0 },
        "max_source_content_age_days": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact_quality": {
      "type": "string",
      "enum": ["pass", "needs_review", "fail"],
      "description": "pass: no evidence issues and no contradictions. needs_review: only review-level issues such as stale evidence or missing locators. fail: any blocking issue or any contradiction."
    },
    "health_assessment": {
      "$ref": "https://truth-tools.dev/schemas/health-assessment.schema.json"
    },
    "reported_program_health": {
      "type": ["string", "null"],
      "enum": ["on_track", "at_risk", "blocked", "unknown", null]
    },
    "claim_health_floor": {
      "type": "string",
      "enum": ["none", "at_risk", "blocked"]
    },
    "program_health": {
      "type": "string",
      "enum": ["on_track", "at_risk", "blocked", "unknown"],
      "description": "Computed by the v2 algorithm in the schema description from active claims and the explicit reported health; an active blocker always resolves to blocked."
    },
    "health_consistency": {
      "type": "string",
      "enum": ["consistent", "missing", "understated", "unsupported", "conflicting"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "claims", "facts", "blockers", "risks", "unknowns", "conflicts", "issues", "deprecations"],
      "properties": {
        "sources": { "type": "integer" },
        "claims": { "type": "integer" },
        "facts": { "type": "integer" },
        "blockers": { "type": "integer" },
        "risks": { "type": "integer" },
        "unknowns": { "type": "integer" },
        "conflicts": { "type": "integer" },
        "issues": { "type": "integer" },
        "deprecations": { "type": "integer" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://truth-tools.dev/schemas/source.schema.json"
      },
      "description": "Normalized sources that satisfy the canonical shape; rejected entities appear as issues with their input location."
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "https://truth-tools.dev/schemas/claim.schema.json"
      },
      "description": "Normalized reviewed Claims; each carries a canonical state, defaulting to active."
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "https://truth-tools.dev/schemas/timeline-item.schema.json"
      }
    },
    "timeline_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "changed", "unchanged", "summary"],
      "properties": {
        "added": {
          "type": "array",
          "items": { "type": "object" }
        },
        "removed": {
          "type": "array",
          "items": { "type": "object" }
        },
        "changed": {
          "type": "array",
          "items": { "type": "object" }
        },
        "unchanged": {
          "type": "array",
          "items": { "type": "object" }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseline", "current", "added", "removed", "changed", "unchanged"],
          "properties": {
            "baseline": { "type": "integer" },
            "current": { "type": "integer" },
            "added": { "type": "integer" },
            "removed": { "type": "integer" },
            "changed": { "type": "integer" },
            "unchanged": { "type": "integer" }
          }
        }
      },
      "description": "Drift is reported, never judged; it carries no issue findings."
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["facts", "blockers", "risks", "unknowns", "conflicts", "issues", "deprecations"],
      "properties": {
        "facts": { "type": "array", "items": { "type": "object" } },
        "blockers": { "type": "array", "items": { "type": "object" } },
        "risks": { "type": "array", "items": { "type": "object" } },
        "unknowns": { "type": "array", "items": { "type": "object" } },
        "conflicts": { "type": "array", "items": { "type": "object" } },
        "issues": { "type": "array", "items": { "type": "object" } },
        "deprecations": { "type": "array", "items": { "type": "object" } }
      }
    },
    "recommended_actions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "type", "action"],
        "properties": {
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "type": { "type": "string", "enum": ["resolve_blocker", "reconcile_conflict", "fix_evidence", "mitigate_risk", "close_unknown", "improve_evidence"] },
          "claim_id": { "type": "string", "minLength": 1 },
          "subject": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  }
}
